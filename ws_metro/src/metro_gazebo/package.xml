<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>metro_gazebo</name>
  <version>0.1.0</version>
  <description>Gazebo Harmonic system plugins for platform screen doors and the train longitudinal motion model.</description>
  <maintainer email="metro@example.com">Metro Simulation Team</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>gz-sim8</depend>
  <depend>gz-transport12</depend>
  <depend>gz-msgs9</depend>
  <depend>gz-plugin2</depend>

  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
