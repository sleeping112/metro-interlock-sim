<?xml version="1.0"?>
<!--
  Gazebo Harmonic (SDF 1.8) description of the 120 m metro train.

  Visual model: six 20 m cars with windows, doors, roof equipment, head/tail
  lights and car-gap shadows.  Physical model: a single train_body box
  (120 x 3 x 3.8 m, 30 t) constrained by the prismatic joint train_longitudinal.
  The body centreline is y=8.65 m, i.e. 0.15 m from the platform edge at y=7.0 m.

  Inputs  : none (model spawned by ros_gz_sim create).
  Outputs : /metro/train/odom from libmetro_train_plugin.so at 50 Hz.
-->
<sdf version="1.8" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:property name="train_length" value="120.0"/>
  <xacro:property name="train_width" value="3.0"/>
  <xacro:property name="train_height" value="3.8"/>
  <xacro:property name="train_mass" value="30000.0"/>
  <xacro:property name="body_y" value="8.65"/>
  <xacro:property name="body_z" value="2.30"/>

  <model name="metro_train">
    <static>false</static>
    <self_collide>false</self_collide>
    <allow_auto_disable>false</allow_auto_disable>
    <pose>0 0 0 0 0 0</pose>

    <link name="train_base">
      <pose>0 0 0 0 0 0</pose>
      <inertial>
        <mass>1.0</mass>
        <inertia>
          <ixx>0.01</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.01</iyy><iyz>0</iyz>
          <izz>0.01</izz>
        </inertia>
      </inertial>
    </link>

    <link name="train_body">
      <pose>0 ${body_y} ${body_z} 0 0 0</pose>
      <inertial>
        <mass>${train_mass}</mass>
        <inertia>
          <ixx>58600.0</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>36036100.0</iyy><iyz>0</iyz>
          <izz>36022500.0</izz>
        </inertia>
      </inertial>

      <collision name="train_body_collision">
        <geometry>
          <box><size>${train_length} ${train_width} ${train_height}</size></box>
        </geometry>
        <surface>
          <friction>
            <ode><mu>0.05</mu><mu2>0.05</mu2></ode>
          </friction>
          <contact>
            <ode><max_vel>0.01</max_vel><min_depth>0.001</min_depth></ode>
          </contact>
        </surface>
      </collision>

      <!-- Six 20 m car shells (visual only; collision is the 120 m box). -->
      <visual name="car_01_body"><pose>-50 0 0 0 0 0</pose><geometry><mesh><uri>model://metro_train/meshes/unit_box.stl</uri><scale>19.6 2.96 3.6</scale></mesh></geometry><material><ambient>0.72 0.76 0.80 1</ambient><diffuse>0.80 0.84 0.88 1</diffuse><specular>0.35 0.35 0.35 1</specular></material></visual>
      <visual name="car_02_body"><pose>-30 0 0 0 0 0</pose><geometry><mesh><uri>model://metro_train/meshes/unit_box.stl</uri><scale>19.6 2.96 3.6</scale></mesh></geometry><material><ambient>0.72 0.76 0.80 1</ambient><diffuse>0.80 0.84 0.88 1</diffuse><specular>0.35 0.35 0.35 1</specular></material></visual>
      <visual name="car_03_body"><pose>-10 0 0 0 0 0</pose><geometry><mesh><uri>model://metro_train/meshes/unit_box.stl</uri><scale>19.6 2.96 3.6</scale></mesh></geometry><material><ambient>0.72 0.76 0.80 1</ambient><diffuse>0.80 0.84 0.88 1</diffuse><specular>0.35 0.35 0.35 1</specular></material></visual>
      <visual name="car_04_body"><pose>10 0 0 0 0 0</pose><geometry><mesh><uri>model://metro_train/meshes/unit_box.stl</uri><scale>19.6 2.96 3.6</scale></mesh></geometry><material><ambient>0.72 0.76 0.80 1</ambient><diffuse>0.80 0.84 0.88 1</diffuse><specular>0.35 0.35 0.35 1</specular></material></visual>
      <visual name="car_05_body"><pose>30 0 0 0 0 0</pose><geometry><mesh><uri>model://metro_train/meshes/unit_box.stl</uri><scale>19.6 2.96 3.6</scale></mesh></geometry><material><ambient>0.72 0.76 0.80 1</ambient><diffuse>0.80 0.84 0.88 1</diffuse><specular>0.35 0.35 0.35 1</specular></material></visual>
      <visual name="car_06_body"><pose>50 0 0 0 0 0</pose><geometry><mesh><uri>model://metro_train/meshes/unit_box.stl</uri><scale>19.6 2.96 3.6</scale></mesh></geometry><material><ambient>0.72 0.76 0.80 1</ambient><diffuse>0.80 0.84 0.88 1</diffuse><specular>0.35 0.35 0.35 1</specular></material></visual>

      <!-- Gangway / car-gap shadow strips. -->
      <visual name="car_gap_01"><pose>-40 0 0 0 0 0</pose><geometry><box><size>0.35 3.0 3.55</size></box></geometry><material><ambient>0.06 0.07 0.08 1</ambient><diffuse>0.08 0.09 0.10 1</diffuse></material></visual>
      <visual name="car_gap_02"><pose>-20 0 0 0 0 0</pose><geometry><box><size>0.35 3.0 3.55</size></box></geometry><material><ambient>0.06 0.07 0.08 1</ambient><diffuse>0.08 0.09 0.10 1</diffuse></material></visual>
      <visual name="car_gap_03"><pose>0 0 0 0 0 0</pose><geometry><box><size>0.35 3.0 3.55</size></box></geometry><material><ambient>0.06 0.07 0.08 1</ambient><diffuse>0.08 0.09 0.10 1</diffuse></material></visual>
      <visual name="car_gap_04"><pose>20 0 0 0 0 0</pose><geometry><box><size>0.35 3.0 3.55</size></box></geometry><material><ambient>0.06 0.07 0.08 1</ambient><diffuse>0.08 0.09 0.10 1</diffuse></material></visual>
      <visual name="car_gap_05"><pose>40 0 0 0 0 0</pose><geometry><box><size>0.35 3.0 3.55</size></box></geometry><material><ambient>0.06 0.07 0.08 1</ambient><diffuse>0.08 0.09 0.10 1</diffuse></material></visual>

      <!-- Blue waistline and window band, both sides. -->
      <visual name="waistline_negative_y"><pose>0 -1.50 -0.55 0 0 0</pose><geometry><box><size>119.8 0.04 0.32</size></box></geometry><material><ambient>0.03 0.16 0.48 1</ambient><diffuse>0.04 0.20 0.58 1</diffuse></material></visual>
      <visual name="waistline_positive_y"><pose>0 1.50 -0.55 0 0 0</pose><geometry><box><size>119.8 0.04 0.32</size></box></geometry><material><ambient>0.03 0.16 0.48 1</ambient><diffuse>0.04 0.20 0.58 1</diffuse></material></visual>
      <visual name="window_band_negative_y"><pose>0 -1.505 0.55 0 0 0</pose><geometry><box><size>117.5 0.03 0.85</size></box></geometry><material><ambient>0.04 0.08 0.12 1</ambient><diffuse>0.06 0.12 0.18 1</diffuse><specular>0.8 0.8 0.8 1</specular></material></visual>
      <visual name="window_band_positive_y"><pose>0 1.505 0.55 0 0 0</pose><geometry><box><size>117.5 0.03 0.85</size></box></geometry><material><ambient>0.04 0.08 0.12 1</ambient><diffuse>0.06 0.12 0.18 1</diffuse><specular>0.8 0.8 0.8 1</specular></material></visual>

      <!-- Twelve door panels aligned with the twelve PSD units. -->
      <visual name="door_01"><pose>-55 -1.52 -0.80 0 0 0</pose><geometry><box><size>1.4 0.04 2.2</size></box></geometry><material><ambient>0.10 0.22 0.40 1</ambient><diffuse>0.12 0.28 0.52 1</diffuse></material></visual>
      <visual name="door_02"><pose>-45 -1.52 -0.80 0 0 0</pose><geometry><box><size>1.4 0.04 2.2</size></box></geometry><material><ambient>0.10 0.22 0.40 1</ambient><diffuse>0.12 0.28 0.52 1</diffuse></material></visual>
      <visual name="door_03"><pose>-35 -1.52 -0.80 0 0 0</pose><geometry><box><size>1.4 0.04 2.2</size></box></geometry><material><ambient>0.10 0.22 0.40 1</ambient><diffuse>0.12 0.28 0.52 1</diffuse></material></visual>
      <visual name="door_04"><pose>-25 -1.52 -0.80 0 0 0</pose><geometry><box><size>1.4 0.04 2.2</size></box></geometry><material><ambient>0.10 0.22 0.40 1</ambient><diffuse>0.12 0.28 0.52 1</diffuse></material></visual>
      <visual name="door_05"><pose>-15 -1.52 -0.80 0 0 0</pose><geometry><box><size>1.4 0.04 2.2</size></box></geometry><material><ambient>0.10 0.22 0.40 1</ambient><diffuse>0.12 0.28 0.52 1</diffuse></material></visual>
      <visual name="door_06"><pose>-5 -1.52 -0.80 0 0 0</pose><geometry><box><size>1.4 0.04 2.2</size></box></geometry><material><ambient>0.10 0.22 0.40 1</ambient><diffuse>0.12 0.28 0.52 1</diffuse></material></visual>
      <visual name="door_07"><pose>5 -1.52 -0.80 0 0 0</pose><geometry><box><size>1.4 0.04 2.2</size></box></geometry><material><ambient>0.10 0.22 0.40 1</ambient><diffuse>0.12 0.28 0.52 1</diffuse></material></visual>
      <visual name="door_08"><pose>15 -1.52 -0.80 0 0 0</pose><geometry><box><size>1.4 0.04 2.2</size></box></geometry><material><ambient>0.10 0.22 0.40 1</ambient><diffuse>0.12 0.28 0.52 1</diffuse></material></visual>
      <visual name="door_09"><pose>25 -1.52 -0.80 0 0 0</pose><geometry><box><size>1.4 0.04 2.2</size></box></geometry><material><ambient>0.10 0.22 0.40 1</ambient><diffuse>0.12 0.28 0.52 1</diffuse></material></visual>
      <visual name="door_10"><pose>35 -1.52 -0.80 0 0 0</pose><geometry><box><size>1.4 0.04 2.2</size></box></geometry><material><ambient>0.10 0.22 0.40 1</ambient><diffuse>0.12 0.28 0.52 1</diffuse></material></visual>
      <visual name="door_11"><pose>45 -1.52 -0.80 0 0 0</pose><geometry><box><size>1.4 0.04 2.2</size></box></geometry><material><ambient>0.10 0.22 0.40 1</ambient><diffuse>0.12 0.28 0.52 1</diffuse></material></visual>
      <visual name="door_12"><pose>55 -1.52 -0.80 0 0 0</pose><geometry><box><size>1.4 0.04 2.2</size></box></geometry><material><ambient>0.10 0.22 0.40 1</ambient><diffuse>0.12 0.28 0.52 1</diffuse></material></visual>

      <!-- Roof equipment: air-conditioning packs and a pantograph. -->
      <visual name="ac_01"><pose>-50 0 1.95 0 0 0</pose><geometry><box><size>4.0 2.0 0.30</size></box></geometry><material><ambient>0.30 0.32 0.34 1</ambient><diffuse>0.40 0.42 0.44 1</diffuse></material></visual>
      <visual name="ac_02"><pose>-30 0 1.95 0 0 0</pose><geometry><box><size>4.0 2.0 0.30</size></box></geometry><material><ambient>0.30 0.32 0.34 1</ambient><diffuse>0.40 0.42 0.44 1</diffuse></material></visual>
      <visual name="ac_03"><pose>-10 0 1.95 0 0 0</pose><geometry><box><size>4.0 2.0 0.30</size></box></geometry><material><ambient>0.30 0.32 0.34 1</ambient><diffuse>0.40 0.42 0.44 1</diffuse></material></visual>
      <visual name="ac_04"><pose>10 0 1.95 0 0 0</pose><geometry><box><size>4.0 2.0 0.30</size></box></geometry><material><ambient>0.30 0.32 0.34 1</ambient><diffuse>0.40 0.42 0.44 1</diffuse></material></visual>
      <visual name="ac_05"><pose>30 0 1.95 0 0 0</pose><geometry><box><size>4.0 2.0 0.30</size></box></geometry><material><ambient>0.30 0.32 0.34 1</ambient><diffuse>0.40 0.42 0.44 1</diffuse></material></visual>
      <visual name="ac_06"><pose>50 0 1.95 0 0 0</pose><geometry><box><size>4.0 2.0 0.30</size></box></geometry><material><ambient>0.30 0.32 0.34 1</ambient><diffuse>0.40 0.42 0.44 1</diffuse></material></visual>
      <visual name="pantograph_base"><pose>-10 0 2.25 0 0 0</pose><geometry><box><size>2.0 1.4 0.10</size></box></geometry><material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.20 0.20 0.20 1</diffuse></material></visual>
      <visual name="pantograph_arm"><pose>-10 0.45 2.65 0.35 0 0</pose><geometry><box><size>0.08 0.08 1.1</size></box></geometry><material><ambient>0.35 0.35 0.35 1</ambient><diffuse>0.45 0.45 0.45 1</diffuse></material></visual>

      <!-- Head and tail lights (visual only). -->
      <visual name="headlight_left"><pose>59.95 -0.95 -1.55 0 0 0</pose><geometry><sphere><radius>0.13</radius></sphere></geometry><material><ambient>1.0 0.95 0.75 1</ambient><diffuse>1.0 0.98 0.85 1</diffuse><emissive>1.0 0.9 0.65 1</emissive></material></visual>
      <visual name="headlight_right"><pose>59.95 0.95 -1.55 0 0 0</pose><geometry><sphere><radius>0.13</radius></sphere></geometry><material><ambient>1.0 0.95 0.75 1</ambient><diffuse>1.0 0.98 0.85 1</diffuse><emissive>1.0 0.9 0.65 1</emissive></material></visual>
      <visual name="taillight_left"><pose>-59.95 -0.95 -1.55 0 0 0</pose><geometry><sphere><radius>0.10</radius></sphere></geometry><material><ambient>0.8 0.05 0.05 1</ambient><diffuse>0.9 0.08 0.08 1</diffuse><emissive>0.8 0.02 0.02 1</emissive></material></visual>
      <visual name="taillight_right"><pose>-59.95 0.95 -1.55 0 0 0</pose><geometry><sphere><radius>0.10</radius></sphere></geometry><material><ambient>0.8 0.05 0.05 1</ambient><diffuse>0.9 0.08 0.08 1</diffuse><emissive>0.8 0.02 0.02 1</emissive></material></visual>

      <!-- Door collision pads, one per PSD unit, on the platform side. -->
      <collision name="train_door_collision_01"><pose>-55.0 -1.54 -0.80 0 0 0</pose><geometry><box><size>1.4 0.06 2.2</size></box></geometry></collision>
      <collision name="train_door_collision_02"><pose>-45.0 -1.54 -0.80 0 0 0</pose><geometry><box><size>1.4 0.06 2.2</size></box></geometry></collision>
      <collision name="train_door_collision_03"><pose>-35.0 -1.54 -0.80 0 0 0</pose><geometry><box><size>1.4 0.06 2.2</size></box></geometry></collision>
      <collision name="train_door_collision_04"><pose>-25.0 -1.54 -0.80 0 0 0</pose><geometry><box><size>1.4 0.06 2.2</size></box></geometry></collision>
      <collision name="train_door_collision_05"><pose>-15.0 -1.54 -0.80 0 0 0</pose><geometry><box><size>1.4 0.06 2.2</size></box></geometry></collision>
      <collision name="train_door_collision_06"><pose>-5.0 -1.54 -0.80 0 0 0</pose><geometry><box><size>1.4 0.06 2.2</size></box></geometry></collision>
      <collision name="train_door_collision_07"><pose>5.0 -1.54 -0.80 0 0 0</pose><geometry><box><size>1.4 0.06 2.2</size></box></geometry></collision>
      <collision name="train_door_collision_08"><pose>15.0 -1.54 -0.80 0 0 0</pose><geometry><box><size>1.4 0.06 2.2</size></box></geometry></collision>
      <collision name="train_door_collision_09"><pose>25.0 -1.54 -0.80 0 0 0</pose><geometry><box><size>1.4 0.06 2.2</size></box></geometry></collision>
      <collision name="train_door_collision_10"><pose>35.0 -1.54 -0.80 0 0 0</pose><geometry><box><size>1.4 0.06 2.2</size></box></geometry></collision>
      <collision name="train_door_collision_11"><pose>45.0 -1.54 -0.80 0 0 0</pose><geometry><box><size>1.4 0.06 2.2</size></box></geometry></collision>
      <collision name="train_door_collision_12"><pose>55.0 -1.54 -0.80 0 0 0</pose><geometry><box><size>1.4 0.06 2.2</size></box></geometry></collision>
    </link>

    <joint name="train_base_fixed" type="fixed">
      <parent>world</parent>
      <child>train_base</child>
    </joint>

    <joint name="train_longitudinal" type="prismatic">
      <parent>train_base</parent>
      <child>train_body</child>
      <axis>
        <xyz>1 0 0</xyz>
        <limit>
          <lower>-240.0</lower>
          <upper>240.0</upper>
          <effort>200000.0</effort>
          <velocity>20.0</velocity>
        </limit>
        <dynamics><damping>0.2</damping><friction>0.05</friction></dynamics>
      </axis>
    </joint>

    <plugin filename="libmetro_train_plugin.so" name="metro::gazebo::TrainLongitudinal">
      <odom_topic>/metro/train/odom</odom_topic>
      <command_topic>/metro/train/command</command_topic>
      <odom_rate_hz>50.0</odom_rate_hz>
      <max_speed_mps>20.0</max_speed_mps>
      <max_accel_mps2>1.0</max_accel_mps2>
      <max_decel_mps2>2.0</max_decel_mps2>
      <rail_y_m>8.65</rail_y_m>
    </plugin>
  </model>
</sdf>
