<?xml version="1.0"?>
<!--
  Reusable single PSD unit template (frame + two sliding leaves).

  The station world inlines four instances with explicit _01.._04 suffixes so
  that every link/joint has a globally unique name (required by the
  DoorController plugin).  This xacro keeps the same geometry as a standalone
  model for reuse in test worlds:

    xacro model.sdf.xacro unit_id:=07

  Inputs : unit_id (two-digit suffix), unit_x (unit centre along the track).
  Outputs: SDF model named psd_unit_<unit_id>; the DoorController world plugin
           owns /metro/psd/unit_<unit_id>/command.
-->
<sdf version="1.8" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="unit_id" default="01"/>
  <xacro:arg name="unit_x" default="0.0"/>
  <xacro:property name="uid" value="$(arg unit_id)"/>
  <xacro:property name="unit_x" value="$(arg unit_x)"/>

  <model name="psd_unit_${uid}">
    <static>false</static>
    <self_collide>false</self_collide>
    <allow_auto_disable>false</allow_auto_disable>
    <pose>${unit_x} 0 0 0 0 0</pose>

    <link name="psd_base_${uid}">
      <pose>0 0 0 0 0 0</pose>
      <inertial>
        <mass>1.0</mass>
        <inertia>
          <ixx>0.001</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.001</iyy><iyz>0</iyz>
          <izz>0.001</izz>
        </inertia>
      </inertial>
    </link>

    <!-- Static-looking frame: all frame geometry is attached to psd_base, which
         is fixed to the world.  Leaves remain dynamic. -->
    <link name="psd_frame_${uid}">
      <pose>0 0 0 0 0 0</pose>
      <collision name="psd_post_left_col_${uid}">
        <pose>-1.90 5.02 1.10 0 0 0</pose>
        <geometry><box><size>0.20 0.10 2.20</size></box></geometry>
      </collision>
      <collision name="psd_post_right_col_${uid}">
        <pose>1.90 5.02 1.10 0 0 0</pose>
        <geometry><box><size>0.20 0.10 2.20</size></box></geometry>
      </collision>
      <collision name="psd_header_col_${uid}">
        <pose>0 5.02 2.70 0 0 0</pose>
        <geometry><box><size>4.00 0.10 0.30</size></box></geometry>
      </collision>
      <visual name="psd_post_left_vis_${uid}">
        <pose>-1.90 5.02 1.10 0 0 0</pose>
        <geometry><box><size>0.20 0.10 2.20</size></box></geometry>
        <material>
          <ambient>0.25 0.28 0.30 1</ambient>
          <diffuse>0.35 0.38 0.40 1</diffuse>
        </material>
      </visual>
      <visual name="psd_post_right_vis_${uid}">
        <pose>1.90 5.02 1.10 0 0 0</pose>
        <geometry><box><size>0.20 0.10 2.20</size></box></geometry>
        <material>
          <ambient>0.25 0.28 0.30 1</ambient>
          <diffuse>0.35 0.38 0.40 1</diffuse>
        </material>
      </visual>
    </link>

    <link name="psd_left_${uid}">
      <pose>-0.90 4.90 1.45 0 0 0</pose>
      <inertial>
        <mass>120.0</mass>
        <inertia>
          <ixx>48.436</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>80.800</iyy><iyz>0</iyz>
          <izz>32.436</izz>
        </inertia>
      </inertial>
      <collision name="psd_left_col_${uid}">
        <geometry><box><size>1.80 0.06 2.20</size></box></geometry>
      </collision>
      <visual name="psd_left_vis_${uid}">
        <transparency>0.60</transparency>
        <geometry><box><size>1.80 0.06 2.20</size></box></geometry>
        <material>
          <ambient>0.55 0.78 0.85 0.4</ambient>
          <diffuse>0.65 0.88 0.95 0.4</diffuse>
        </material>
      </visual>
    </link>

    <link name="psd_right_${uid}">
      <pose>0.90 4.90 1.45 0 0 0</pose>
      <inertial>
        <mass>120.0</mass>
        <inertia>
          <ixx>48.436</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>80.800</iyy><iyz>0</iyz>
          <izz>32.436</izz>
        </inertia>
      </inertial>
      <collision name="psd_right_col_${uid}">
        <geometry><box><size>1.80 0.06 2.20</size></box></geometry>
      </collision>
      <visual name="psd_right_vis_${uid}">
        <transparency>0.60</transparency>
        <geometry><box><size>1.80 0.06 2.20</size></box></geometry>
        <material>
          <ambient>0.55 0.78 0.85 0.4</ambient>
          <diffuse>0.65 0.88 0.95 0.4</diffuse>
        </material>
      </visual>
    </link>

    <!-- psd_base is fixed to world; the frame is therefore static in practice. -->
    <joint name="psd_base_fixed_${uid}" type="fixed">
      <parent>psd_base_${uid}</parent>
      <child>psd_frame_${uid}</child>
    </joint>

    <joint name="psd_left_joint_${uid}" type="prismatic">
      <parent>psd_base_${uid}</parent>
      <child>psd_left_${uid}</child>
      <axis>
        <xyz>1 0 0</xyz>
        <limit>
          <lower>-1.80</lower>
          <upper>0.0</upper>
          <effort>5000.0</effort>
          <velocity>1.0</velocity>
        </limit>
        <dynamics><damping>2.0</damping><friction>0.2</friction></dynamics>
      </axis>
    </joint>

    <joint name="psd_right_joint_${uid}" type="prismatic">
      <parent>psd_base_${uid}</parent>
      <child>psd_right_${uid}</child>
      <axis>
        <xyz>1 0 0</xyz>
        <limit>
          <lower>0.0</lower>
          <upper>1.80</upper>
          <effort>5000.0</effort>
          <velocity>1.0</velocity>
        </limit>
        <dynamics><damping>2.0</damping><friction>0.2</friction></dynamics>
      </axis>
    </joint>
  </model>
</sdf>
