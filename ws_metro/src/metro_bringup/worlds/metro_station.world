        <visual name="arm_left_11"><pose>-0.26 0 1.04 0 0 0</pose><geometry><box><size>0.10 0.12 0.55</size></box></geometry><material><ambient>0.18 0.18 0.20 1</ambient><diffuse>0.25 0.25 0.28 1</diffuse></material></visual>
        <visual name="arm_right_11"><pose>0.26 0 1.04 0 0 0</pose><geometry><box><size>0.10 0.12 0.55</size></box></geometry><material><ambient>0.18 0.18 0.20 1</ambient><diffuse>0.25 0.25 0.28 1</diffuse></material></visual>
      </link>
    </model>

    <model name="passenger_12">
      <static>true</static>
      <allow_auto_disable>false</allow_auto_disable>
      <pose>45.0 -0.20 0.30 0 0 0</pose>
      <link name="passenger_body_12">
        <visual name="leg_left_12"><pose>-0.10 0 0.36 0 0 0</pose><geometry><box><size>0.12 0.13 0.72</size></box></geometry><material><ambient>0.10 0.12 0.16 1</ambient><diffuse>0.16 0.18 0.22 1</diffuse></material></visual>
        <visual name="leg_right_12"><pose>0.10 0 0.36 0 0 0</pose><geometry><box><size>0.12 0.13 0.72</size></box></geometry><material><ambient>0.10 0.12 0.16 1</ambient><diffuse>0.16 0.18 0.22 1</diffuse></material></visual>
        <visual name="torso_12"><pose>0 0 1.02 0 0 0</pose><geometry><box><size>0.40 0.26 0.62</size></box></geometry><material><ambient>0.34 0.18 0.42 1</ambient><diffuse>0.44 0.24 0.54 1</diffuse></material></visual>
        <visual name="head_12"><pose>0 0 1.52 0 0 0</pose><geometry><box><size>0.24 0.24 0.28</size></box></geometry><material><ambient>0.55 0.38 0.26 1</ambient><diffuse>0.68 0.48 0.33 1</diffuse></material></visual>
        <visual name="hair_12"><pose>0 0 1.66 0 0 0</pose><geometry><box><size>0.25 0.25 0.08</size></box></geometry><material><ambient>0.06 0.05 0.04 1</ambient><diffuse>0.10 0.08 0.06 1</diffuse></material></visual>
        <visual name="arm_left_12"><pose>-0.26 0 1.04 0 0 0</pose><geometry><box><size>0.10 0.12 0.55</size></box></geometry><material><ambient>0.34 0.18 0.42 1</ambient><diffuse>0.44 0.24 0.54 1</diffuse></material></visual>
        <visual name="arm_right_12"><pose>0.26 0 1.04 0 0 0</pose><geometry><box><size>0.10 0.12 0.55</size></box></geometry><material><ambient>0.34 0.18 0.42 1</ambient><diffuse>0.44 0.24 0.54 1</diffuse></material></visual>
      </link>
    </model>


    <model name="ambient_train">
      <static>true</static>
      <allow_auto_disable>false</allow_auto_disable>
      <pose>-160.0 -8.65 2.30 0 0 0</pose>
      <link name="ambient_train_body">
        <visual name="ambient_car_0"><pose>-50 0 0 0 0 0</pose><geometry><box><size>19.6 2.96 3.6</size></box></geometry><material><ambient>0.58 0.62 0.66 1</ambient><diffuse>0.72 0.76 0.80 1</diffuse></material></visual><visual name="ambient_window_0"><pose>-50 -1.505 0.55 0 0 0</pose><geometry><box><size>17.5 0.03 0.80</size></box></geometry><material><ambient>0.03 0.07 0.10 1</ambient><diffuse>0.05 0.10 0.14 1</diffuse></material></visual><visual name="ambient_car_1"><pose>-30 0 0 0 0 0</pose><geometry><box><size>19.6 2.96 3.6</size></box></geometry><material><ambient>0.58 0.62 0.66 1</ambient><diffuse>0.72 0.76 0.80 1</diffuse></material></visual><visual name="ambient_window_1"><pose>-30 -1.505 0.55 0 0 0</pose><geometry><box><size>17.5 0.03 0.80</size></box></geometry><material><ambient>0.03 0.07 0.10 1</ambient><diffuse>0.05 0.10 0.14 1</diffuse></material></visual><visual name="ambient_car_2"><pose>-10 0 0 0 0 0</pose><geometry><box><size>19.6 2.96 3.6</size></box></geometry><material><ambient>0.58 0.62 0.66 1</ambient><diffuse>0.72 0.76 0.80 1</diffuse></material></visual><visual name="ambient_window_2"><pose>-10 -1.505 0.55 0 0 0</pose><geometry><box><size>17.5 0.03 0.80</size></box></geometry><material><ambient>0.03 0.07 0.10 1</ambient><diffuse>0.05 0.10 0.14 1</diffuse></material></visual><visual name="ambient_car_3"><pose>10 0 0 0 0 0</pose><geometry><box><size>19.6 2.96 3.6</size></box></geometry><material><ambient>0.58 0.62 0.66 1</ambient><diffuse>0.72 0.76 0.80 1</diffuse></material></visual><visual name="ambient_window_3"><pose>10 -1.505 0.55 0 0 0</pose><geometry><box><size>17.5 0.03 0.80</size></box></geometry><material><ambient>0.03 0.07 0.10 1</ambient><diffuse>0.05 0.10 0.14 1</diffuse></material></visual><visual name="ambient_car_4"><pose>30 0 0 0 0 0</pose><geometry><box><size>19.6 2.96 3.6</size></box></geometry><material><ambient>0.58 0.62 0.66 1</ambient><diffuse>0.72 0.76 0.80 1</diffuse></material></visual><visual name="ambient_window_4"><pose>30 -1.505 0.55 0 0 0</pose><geometry><box><size>17.5 0.03 0.80</size></box></geometry><material><ambient>0.03 0.07 0.10 1</ambient><diffuse>0.05 0.10 0.14 1</diffuse></material></visual><visual name="ambient_car_5"><pose>50 0 0 0 0 0</pose><geometry><box><size>19.6 2.96 3.6</size></box></geometry><material><ambient>0.58 0.62 0.66 1</ambient><diffuse>0.72 0.76 0.80 1</diffuse></material></visual><visual name="ambient_window_5"><pose>50 -1.505 0.55 0 0 0</pose><geometry><box><size>17.5 0.03 0.80</size></box></geometry><material><ambient>0.03 0.07 0.10 1</ambient><diffuse>0.05 0.10 0.14 1</diffuse></material></visual><visual name="ambient_headlight"><pose>59.9 0.85 -1.55 0 0 0</pose><geometry><box><size>0.16 0.16 0.16</size></box></geometry><material><ambient>0.55 0.04 0.04 1</ambient><diffuse>0.75 0.06 0.06 1</diffuse><emissive>0.40 0.01 0.01 1</emissive></material></visual>
      </link>
      <plugin filename="libmetro_ambient_train.so" name="metro::gazebo::AmbientTrain">
        <loop_start_x>-200.0</loop_start_x>
        <loop_end_x>200.0</loop_end_x>
        <speed_mps>9.0</speed_mps>
        <period_s>55.0</period_s>
      </plugin>
    </model>


    <!-- Forward-looking platform camera (C-stage perception input). -->
    <model name="platform_camera">
      <static>true</static>
      <pose>-55 0 4.7 0 0 0</pose>
      <link name="platform_camera_link">
        <sensor name="platform_camera" type="camera">
          <always_on>true</always_on>
          <visualize>false</visualize>
          <update_rate>10</update_rate>
          <topic>/metro/camera/platform/image</topic>
          <camera>
            <horizontal_fov>1.35</horizontal_fov>
            <image><width>640</width><height>480</height><format>R8G8B8</format></image>
            <clip><near>0.1</near><far>120.0</far></clip>
            <noise><type>gaussian</type><mean>0.0</mean><stddev>0.002</stddev></noise>
          </camera>
        </sensor>
      </link>
    </model>


    <!-- World-level PSD actuator for all twelve units. -->
    <plugin filename="libmetro_door_controller.so" name="metro::gazebo::DoorController">
      <unit_count>12</unit_count>
      <unit_model_prefix>psd_door_</unit_model_prefix>
      <left_joint_prefix>psd_left_joint_</left_joint_prefix>
      <right_joint_prefix>psd_right_joint_</right_joint_prefix>
      <door_speed_mps>0.8</door_speed_mps>
      <door_travel_m>1.8</door_travel_m>
      <state_rate_hz>10.0</state_rate_hz>
      <lock_delay_s>0.3</lock_delay_s>
      <open_position_tolerance_m>0.01</open_position_tolerance_m>
    </plugin>

    <!-- Deterministic low-poly passenger flow, triggered by /metro/psd/state. -->
    <plugin filename="libmetro_passenger_flow.so" name="metro::gazebo::PassengerFlow">
      <passenger_prefix>passenger_</passenger_prefix>
      <passenger_count>12</passenger_count>
      <door_start_x>-55.0</door_start_x>
      <door_spacing_m>10.0</door_spacing_m>
      <door_y_m>6.90</door_y_m>
      <walk_speed_mps>1.25</walk_speed_mps>
      <start_delay_s>0.8</start_delay_s>
      <stagger_s>0.35</stagger_s>
    </plugin>

    <!-- Ground-truth platform-edge intrusion detector. -->
    <plugin filename="libmetro_intrusion_detector.so" name="metro::gazebo::PlatformIntrusionDetector">
      <passenger_prefix>passenger_</passenger_prefix>
      <danger_y_min_m>6.55</danger_y_min_m>
      <danger_y_max_m>7.15</danger_y_max_m>
      <publish_rate_hz>10.0</publish_rate_hz>
    </plugin>
  </world>
</sdf>
