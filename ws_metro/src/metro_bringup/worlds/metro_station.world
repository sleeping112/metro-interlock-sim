<?xml version="1.0" ?>
<!--
  Enriched single-line metro station (SDF 1.8).

  Layout:
    * island platform 130 x 14 m, top at z=0.30
    * train track centre y=+8.65, opposite track centre y=-8.65
    * 12 PSD units at x=-55..+55 (10 m spacing)
    * six 20 m train cars, 120 m total, alongside the platform
    * station structure, furniture, signage, tunnels, overhead line
    * 12 animated passengers, one ambient opposite train
    * DoorController, PassengerFlow and PlatformIntrusionDetector plugins
-->
<sdf version="1.8">
  <world name="metro_station">
    <gravity>0 0 -9.8</gravity>
    <physics name="metro_physics" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>100</real_time_update_rate>
      <dart>
        <solver><solver_type>dantzig</solver_type></solver>
        <collision_detector>bullet</collision_detector>
      </dart>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>

    <scene>
      <ambient>0.58 0.60 0.64 1</ambient>
      <background>0.68 0.76 0.86 1</background>
      <shadows>true</shadows>
    </scene>

    <light type="directional" name="station_sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 20 0 0 0</pose>
      <diffuse>0.92 0.90 0.84 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.35 0.25 -0.90</direction>
    </light>
    <light type="point" name="platform_fill">
      <pose>0 0 5.0 0 0 0</pose>
      <diffuse>0.55 0.58 0.64 1</diffuse>
      <specular>0.08 0.08 0.08 1</specular>
      <attenuation><range>45</range><constant>0.55</constant><linear>0.02</linear><quadratic>0.0</quadratic></attenuation>
    </light>
    <light type="point" name="platform_light_west">
      <pose>-45 0 4.8 0 0 0</pose>
      <diffuse>0.65 0.62 0.52 1</diffuse>
      <attenuation><range>40</range><constant>0.6</constant><linear>0.03</linear><quadratic>0.0</quadratic></attenuation>
    </light>
    <light type="point" name="platform_light_east">
      <pose>45 0 4.8 0 0 0</pose>
      <diffuse>0.65 0.62 0.52 1</diffuse>
      <attenuation><range>40</range><constant>0.6</constant><linear>0.03</linear><quadratic>0.0</quadratic></attenuation>
    </light>
    <light type="point" name="tunnel_light_west">
      <pose>-78 8.65 3.4 0 0 0</pose>
      <diffuse>0.30 0.38 0.50 1</diffuse>
      <attenuation><range>25</range><constant>0.5</constant><linear>0.04</linear><quadratic>0.0</quadratic></attenuation>
    </light>
    <light type="point" name="tunnel_light_east">
      <pose>78 8.65 3.4 0 0 0</pose>
      <diffuse>0.30 0.38 0.50 1</diffuse>
      <attenuation><range>25</range><constant>0.5</constant><linear>0.04</linear><quadratic>0.0</quadratic></attenuation>
    </light>


    <!-- Island platform: 130 x 14 x 0.3 m, top at z=0.30. -->
    <model name="station_platform">
      <static>true</static>
      <link name="platform_link">
        <collision name="platform_collision"><pose>0 0 0.15 0 0 0</pose><geometry><box><size>130.0 14.0 0.3</size></box></geometry></collision>
        <visual name="platform_top_visual"><pose>0 0 0.15 0 0 0</pose><geometry><box><size>130.0 14.0 0.3</size></box></geometry><material><ambient>0.50 0.52 0.50 1</ambient><diffuse>0.66 0.67 0.63 1</diffuse></material></visual><visual name="platform_front_edge"><pose>0 6.95 0.31 0 0 0</pose><geometry><box><size>130.0 0.10 0.02</size></box></geometry><material><ambient>0.38 0.39 0.38 1</ambient><diffuse>0.50 0.51 0.50 1</diffuse></material></visual><visual name="safety_line_visual"><pose>0 6.85 0.305 0 0 0</pose><geometry><box><size>130.0 0.10 0.01</size></box></geometry><material><ambient>0.96 0.72 0.04 1</ambient><diffuse>0.98 0.78 0.08 1</diffuse></material></visual><visual name="tactile_strip_visual"><pose>0 6.55 0.305 0 0 0</pose><geometry><box><size>130.0 0.35 0.01</size></box></geometry><material><ambient>0.82 0.62 0.06 1</ambient><diffuse>0.88 0.68 0.10 1</diffuse></material></visual><visual name="platform_inlay_0"><pose>0 -5.5 0.305 0 0 0</pose><geometry><box><size>130.0 0.04 0.008</size></box></geometry><material><ambient>0.35 0.38 0.40 1</ambient><diffuse>0.45 0.48 0.50 1</diffuse></material></visual><visual name="platform_inlay_1"><pose>0 -3.0 0.305 0 0 0</pose><geometry><box><size>130.0 0.04 0.008</size></box></geometry><material><ambient>0.35 0.38 0.40 1</ambient><diffuse>0.45 0.48 0.50 1</diffuse></material></visual><visual name="platform_inlay_2"><pose>0 -0.5 0.305 0 0 0</pose><geometry><box><size>130.0 0.04 0.008</size></box></geometry><material><ambient>0.35 0.38 0.40 1</ambient><diffuse>0.45 0.48 0.50 1</diffuse></material></visual><visual name="platform_inlay_3"><pose>0 2.0 0.305 0 0 0</pose><geometry><box><size>130.0 0.04 0.008</size></box></geometry><material><ambient>0.35 0.38 0.40 1</ambient><diffuse>0.45 0.48 0.50 1</diffuse></material></visual><visual name="platform_inlay_4"><pose>0 4.5 0.305 0 0 0</pose><geometry><box><size>130.0 0.04 0.008</size></box></geometry><material><ambient>0.35 0.38 0.40 1</ambient><diffuse>0.45 0.48 0.50 1</diffuse></material></visual><visual name="platform_tile_band_0"><pose>-60 0 0.305 0 0 0</pose><geometry><box><size>0.06 14.0 0.008</size></box></geometry><material><ambient>0.42 0.44 0.43 1</ambient><diffuse>0.55 0.57 0.55 1</diffuse></material></visual><visual name="platform_tile_band_1"><pose>-40 0 0.305 0 0 0</pose><geometry><box><size>0.06 14.0 0.008</size></box></geometry><material><ambient>0.42 0.44 0.43 1</ambient><diffuse>0.55 0.57 0.55 1</diffuse></material></visual><visual name="platform_tile_band_2"><pose>-20 0 0.305 0 0 0</pose><geometry><box><size>0.06 14.0 0.008</size></box></geometry><material><ambient>0.42 0.44 0.43 1</ambient><diffuse>0.55 0.57 0.55 1</diffuse></material></visual><visual name="platform_tile_band_3"><pose>0 0 0.305 0 0 0</pose><geometry><box><size>0.06 14.0 0.008</size></box></geometry><material><ambient>0.42 0.44 0.43 1</ambient><diffuse>0.55 0.57 0.55 1</diffuse></material></visual><visual name="platform_tile_band_4"><pose>20 0 0.305 0 0 0</pose><geometry><box><size>0.06 14.0 0.008</size></box></geometry><material><ambient>0.42 0.44 0.43 1</ambient><diffuse>0.55 0.57 0.55 1</diffuse></material></visual><visual name="platform_tile_band_5"><pose>40 0 0.305 0 0 0</pose><geometry><box><size>0.06 14.0 0.008</size></box></geometry><material><ambient>0.42 0.44 0.43 1</ambient><diffuse>0.55 0.57 0.55 1</diffuse></material></visual><visual name="platform_tile_band_6"><pose>60 0 0.305 0 0 0</pose><geometry><box><size>0.06 14.0 0.008</size></box></geometry><material><ambient>0.42 0.44 0.43 1</ambient><diffuse>0.55 0.57 0.55 1</diffuse></material></visual>
      </link>
    </model>


    <model name="track_bed_positive_y">
      <static>true</static>
      <link name="track_link_positive_y">
        <collision name="track_collision_positive_y"><pose>0 8.65 0.10 0 0 0</pose><geometry><box><size>180.0 2.0 0.20</size></box></geometry></collision><visual name="track_ballast_positive_y"><pose>0 8.65 0.10 0 0 0</pose><geometry><box><size>180.0 2.0 0.20</size></box></geometry><material><ambient>0.16 0.16 0.16 1</ambient><diffuse>0.23 0.23 0.23 1</diffuse></material></visual><visual name="rail_inner_positive_y"><pose>0 7.95 0.24 0 0 0</pose><geometry><box><size>180.0 0.08 0.08</size></box></geometry><material><ambient>0.34 0.36 0.39 1</ambient><diffuse>0.50 0.52 0.55 1</diffuse><specular>0.8 0.8 0.8 1</specular></material></visual><visual name="rail_outer_positive_y"><pose>0 9.35 0.24 0 0 0</pose><geometry><box><size>180.0 0.08 0.08</size></box></geometry><material><ambient>0.34 0.36 0.39 1</ambient><diffuse>0.50 0.52 0.55 1</diffuse><specular>0.8 0.8 0.8 1</specular></material></visual><visual name="sleeper_positive_y_00"><pose>-87.0 8.65 0.245 0 0 0</pose><geometry><box><size>0.28 2.15 0.08</size></box></geometry><material><ambient>0.24 0.20 0.16 1</ambient><diffuse>0.32 0.27 0.21 1</diffuse></material></visual><visual name="sleeper_positive_y_01"><pose>-81.0 8.65 0.245 0 0 0</pose><geometry><box><size>0.28 2.15 0.08</size></box></geometry><material><ambient>0.24 0.20 0.16 1</ambient><diffuse>0.32 0.27 0.21 1</diffuse></material></visual><visual name="sleeper_positive_y_02"><pose>-75.0 8.65 0.245 0 0 0</pose><geometry><box><size>0.28 2.15 0.08</size></box></geometry><material><ambient>0.24 0.20 0.16 1</ambient><diffuse>0.32 0.27 0.21 1</diffuse></material></visual><visual name="sleeper_positive_y_03"><pose>-69.0 8.65 0.245 0 0 0</pose><geometry><box><size>0.28 2.15 0.08</size></box></geometry><material><ambient>0.24 0.20 0.16 1</ambient><diffuse>0.32 0.27 0.21 1</diffuse></material></visual><visual name="sleeper_positive_y_04"><pose>-63.0 8.65 0.245 0 0 0</pose><geometry><box><size>0.28 2.15 0.08</size></box></geometry><material><ambient>0.24 0.20 0.16 1</amb